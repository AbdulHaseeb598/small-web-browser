# Host ports; container ports remain 3000 and 4000.
FRONTEND_PORT=3000
BACKEND_PORT=4000

# Internal Docker hostname, not localhost. No credentials needed in isolated dev.
MONGODB_URI=mongodb://mongodb:27017/small_web_browser

# Browser origin permitted by backend CORS. Match FRONTEND_PORT if changed.
FRONTEND_ORIGIN=http://localhost:3000

# Browser requests use the host-published backend port. Match BACKEND_PORT.
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Compose sets server-side API_URL=http://backend:4000/api automatically.
# These development defaults are not a production deployment configuration.
